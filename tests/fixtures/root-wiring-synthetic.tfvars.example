# SYNTHETIC probe inputs for scripts/root_wiring_check.py — NON-PRODUCTION.
# Every value is a structurally valid placeholder (zero-account ARNs, example.com,
# documentation-style names). No real account id, domain, bucket, certificate,
# zone, secret, backend value, or credential appears here, and the offline probe
# plan these feed is never applied. New required root variables must be added
# here (a governed, visible change) or the positive control P1 fails closed with
# "No value for required variable".
vpc_cidr             = "10.255.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
web_fqdn             = "synthetic.example.com"
hosted_zone_id       = "ZSYNTH00000000000000"
acm_certificate_arn  = "arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"
api_certificate_arn  = "arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000001"
api_fqdn             = "api.synthetic.example.com" # P6-INF-3 windowed alias; must differ from web_fqdn
app_bucket_name      = "synthetic-probe-bucket-000000"
db_engine_version    = "16.4"
db_name              = "synthetic"
db_master_username   = "synthetic_admin"
redis_engine_version = "7.1"
llm_provider         = "anthropic"
monthly_budget_limit = 20 # the operator limit (USD 20 TOTAL/month) is also the root's upper bound

budget_notification_email = "probe@example.com"
role_boundary_mode        = "disabled"

alarm_thresholds = {
  ecs_cpu_high_percent          = 80
  ecs_memory_high_percent       = 80
  log_error_count_per_period    = 1
  rds_cpu_high_percent          = 80
  rds_free_storage_low_bytes    = 1000000000
  rds_freeable_memory_low_bytes = 100000000
  redis_cpu_high_percent        = 80
  redis_memory_high_percent     = 80
}

# Staging window (REQUIRED root input, no default). true keeps the positive-control
# plan's resource set identical to the always-on composition it has always planned;
# the closed state is proven by the module tests (alb/data_cache/network window tests)
# and by tests/test_staging_window.py.
staging_window_active = true

# 6B-4C (P6-AUTH-2, FD-1): transactional-mail inputs, REQUIRED at the root. Synthetic
# documentation values only — a bare FQDN and one bare address at it.
mail_sending_identity_domain = "mail.synthetic.example.com"
mail_from_address            = "no-reply@mail.synthetic.example.com"
