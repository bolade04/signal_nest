# terraform.tfvars.example — synthetic, non-sensitive example inputs
#
# WARNING: This is an EXAMPLE template only. NEVER replace these values with real
# credentials, account ids, ARNs, KMS ids, domains, CIDRs, database credentials,
# or any sensitive identifier, and NEVER commit a filled-in real `.tfvars`. Real
# `*.tfvars` files are git-ignored; only `*.tfvars.example` is tracked.
#
# All values below are synthetic logical labels safe for the public repository.

project_name = "SignalNest"
environment  = "staging"
aws_region   = "us-east-1"
alias        = "SIGNALNEST_STAGING"
owner        = "internal-platform-ops"
cost_center  = "signalnest-staging"
data_class   = "internal-no-customer"
phase        = "4B-C"

# --- Network module inputs (INFRA-4 network tranche) ---
# Addressing is variable-driven and NO real CIDR or AZ name is committed to this
# repository. Supply real values at plan time via a git-ignored *.tfvars file.
# The lines below are COMMENTED and use placeholder tokens, not real values:
#
# vpc_cidr           = "<RFC1918_CIDR>"        # e.g. a private /16 range
# availability_zones = ["<AZ_ONE>", "<AZ_TWO>"] # explicit AZ names (>= 2 recommended)
# subnet_newbits     = 4
# enable_nat_gateway = true

# --- Edge module inputs (INFRA-4 edge tranche; web/SPA only) ---
# The ACM certificate and Route 53 hosted zone are CONSUMED by value (never created
# by the module). NO real domain, hosted-zone id, or certificate ARN is committed to
# this repository. Supply real values at plan time via a git-ignored *.tfvars file.
# The lines below are COMMENTED and use placeholder tokens, not real values:
#
# web_fqdn            = "<WEB_FQDN>"                  # e.g. app.staging.example.com (bare hostname)
# hosted_zone_id      = "<ROUTE53_HOSTED_ZONE_ID>"   # existing zone that owns web_fqdn (starts with Z)
# acm_certificate_arn = "<ACM_CERT_ARN_US_EAST_1>"   # existing us-east-1 ACM cert ARN
# price_class         = "PriceClass_100"

# --- Composition inputs (INFRA-4 root-composition tranche; synthetic examples only) ---
# app_bucket_name           = "<globally-unique-app-bucket-name>"
# db_engine_version         = "<postgres-version, e.g. 16.4>"
# db_name                   = "<initial-database-name>"
# db_master_username        = "<master-username>"          # password is RDS-managed; never in tfvars
# redis_engine_version      = "<redis-version, e.g. 7.1>"
# api_image_digest          = "sha256:<64-hex-digest-of-verified-api-image>"     # exists only after INFRA-5
# worker_image_digest       = "sha256:<64-hex-digest-of-verified-worker-image>"  # exists only after INFRA-5
# llm_provider              = "<openai|anthropic>"                                # the operator's settled choice is recorded in docs/project-phase-6-plan.md P6-D04
# alarm_thresholds = {
#   ecs_cpu_high_percent          = <1-100>
#   ecs_memory_high_percent       = <1-100>
#   log_error_count_per_period    = <positive-count>
#   rds_cpu_high_percent          = <1-100>
#   rds_free_storage_low_bytes    = <positive-bytes>
#   rds_freeable_memory_low_bytes = <positive-bytes>
#   redis_cpu_high_percent        = <1-100>
#   redis_memory_high_percent     = <1-100>
# }
# sns_topic_arn             = null                          # or "arn:aws:sns:<region>:<account>:<topic>"
# monthly_budget_limit      = <1-200>                       # USD; ADR-0001 §M hard ceiling
# budget_notification_email = "<ops-alias@example.com>"

# --- Staging operating window (docs/operations/staging-window.md) --------------------
# REQUIRED, no default. false = CLOSED: the NAT gateway (+EIP), ALB (+listener, target
# group) and the ElastiCache replication group are absent/destroyed and their public
# IPv4 addresses released; the workload stage is refused. true = an AUTHORIZED window is
# open. Does not stop or start RDS (runbook). Every execution states the target state.
staging_window_active = false

# --- Transactional account mail (P6-AUTH-2 / 6B-4C, founder decision FD-1) ------------
# AWS SES v2 through the API task role: no SMTP credential, no mail secret. The SES
# DOMAIN identity and its DKIM DNS records are provisioned OUT OF BAND under their own
# authorization — never by this IaC, which only names the identity so the IAM grant and
# the task environment agree. NO real domain or address is committed; supply real values
# at plan time via a git-ignored *.tfvars file. Placeholder tokens only:
#
# mail_sending_identity_domain = "<MAIL_SENDING_IDENTITY_FQDN>"                    # e.g. mail.staging.example.com (bare hostname; the SES domain identity)
# mail_from_address            = "<ROLE_LOCAL_PART>@<MAIL_SENDING_IDENTITY_FQDN>"  # one bare address AT that domain; no display name

# --- IAM role permissions boundary (Gate 4N-I8) --------------------------------------
#
# DURABILITY. `permissions_boundary` is a MANAGED attribute on all eight roles. If the
# boundary is attached out-of-band and a later execution supplies null, OpenTofu plans
# REMOVAL and the next apply strips it from every deployed role. That is the Gate 4N-I7
# durability defect, so the mode is now explicit and "disabled" must be chosen deliberately.
#
# disabled : no boundary is attached — the pre-rollout dark state. (An earlier revision of
#            this comment called it "the currently deployed state"; this file does not
#            know the deployed state and no longer claims it. Against roles that already
#            carry the boundary, "disabled" would PLAN ITS REMOVAL — Gate 4N-I7 — so read
#            the live state first and choose "required" for any such execution.)
# required : role_permissions_boundary_arn is REQUIRED and must name the reviewed policy
#            signalnest-staging-role-boundary, or the plan fails before any mutation.
#            (The variable accepts exactly "disabled" or "required"; an earlier revision of
#            this comment wrote "enforced", which the validation rejects.)
#
# Switch to "required" only after an authorized gate has created the boundary policy in AWS.
# REQUIRED. There is no default — omitting this fails before planning, because a boundary
# that vanishes through omission is not a boundary (Gate 4N-I14 Defect 3).
role_boundary_mode = "disabled"
# role_boundary_mode            = "required"
# role_permissions_boundary_arn = "arn:aws:iam::<account>:policy/signalnest-staging-role-boundary"
