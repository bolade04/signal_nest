{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SesV2SendFromApprovedIdentity",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "arn:aws:ses:us-east-1:111122223333:identity/mail.staging.example.com",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "no-reply@mail.staging.example.com",
          "ses:ApiVersion": "2"
        }
      }
    }
  ]
}
