# alerting.tf — alarm delivery (P6-INF-4), ALB alarms (P6-INF-6) and application-metric
# alarms (P6-INF-5) for the staging observability plane.
#
# DELIVERY (P6-INF-4). Every alarm owned by this module — the fifteen in main.tf and the ones
# below — sends its ALARM and OK transitions to ONE module-owned SNS topic. The human
# destination is an e-mail subscription whose address is an OPERATOR VALUE supplied through
# a git-ignored *.tfvars (root input `alarm_notification_email`); none is committed. AWS
# creates an e-mail subscription in "PendingConfirmation": nothing is delivered until the
# recipient clicks the confirmation link AWS sends — a live human act no apply can perform
# (docs/operations/alerts.md, "Delivery"). An unconfirmed subscription lapses after three
# days and the next plan re-creates it.
#
# ENCRYPTION. The IaC gate fails HIGH misconfigurations, and an SNS topic without a
# customer-managed key is one (an AWS-managed `alias/aws/sns` key is not enough: CloudWatch
# cannot use it, so alarms could not publish). The topic therefore uses a dedicated key OWNED
# HERE, whose policy is the account-root delegation plus the two actions AWS documents for
# CloudWatch alarms publishing to an encrypted topic. Like the SPA and audit keys of P6-CI-6,
# no reviewed principal can create or read it yet (infra/aws/README.md, pending apply
# closures).
#
# ALB ALARMS (P6-INF-6). The load balancer exists only inside a staging window, and its
# metric dimensions (LoadBalancer = app/<name>/<id>, TargetGroup = targetgroup/<name>/<id>)
# change every time a window re-creates it. The three ALB alarms therefore follow the window
# through `alb_alarms_enabled` — the alb module's echo of its window input, known at plan
# time — and are created after, and destroyed with, the load balancer they watch.
#
# APPLICATION METRICS (P6-INF-5). The API writes CloudWatch Embedded Metric Format documents
# to its log stream (apps/api/app/core/metrics_emf.py); CloudWatch Logs extracts them into
# `app_metrics.namespace` with the dimension sets [service, environment] and
# [service, environment, <labels>]. The two alarms below implement docs/operations/alerts.md
# §1 (5xx ratio) and §2 (p95 latency) on exactly those dimension sets. No metric filter is
# needed for them.

locals {
  alarm_topic_name = "${var.name_prefix}-alarms"
  alarm_topic_arn  = "arn:${data.aws_partition.current.partition}:sns:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:${local.alarm_topic_name}"
  # Every alarm this module owns is named "<name_prefix>-…" (the topic policy's source bound).
  alarm_arn_pattern = "arn:${data.aws_partition.current.partition}:cloudwatch:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:alarm:${var.name_prefix}-*"

  alb_alarms = var.alb_alarms_enabled ? {
    alb-elb-5xx = {
      metric      = "HTTPCode_ELB_5XX_Count"
      statistic   = "Sum"
      period      = local.period_seconds
      evaluations = 1
      threshold   = var.alarm_thresholds.alb_5xx_count_per_period
      dimensions  = { LoadBalancer = var.alb_arn_suffix }
      description = "5xx responses generated by the load balancer itself (no healthy target, target timeout or connection failure, ...) reached the caller-supplied count within one 5-minute period. Missing data is not breaching: the ALB publishes the count only when it is non-zero."
    }
    alb-target-5xx = {
      metric      = "HTTPCode_Target_5XX_Count"
      statistic   = "Sum"
      period      = local.period_seconds
      evaluations = 1
      threshold   = var.alarm_thresholds.alb_5xx_count_per_period
      dimensions  = { LoadBalancer = var.alb_arn_suffix, TargetGroup = var.api_target_group_arn_suffix }
      description = "5xx responses returned by the API targets reached the caller-supplied count within one 5-minute period. Missing data is not breaching: the ALB publishes the count only when it is non-zero."
    }
    alb-unhealthy-hosts = {
      metric      = "UnHealthyHostCount"
      statistic   = "Maximum"
      period      = 60
      evaluations = 3
      # Intrinsic threshold: the API runs one task (api_desired_count = 1), so a single
      # unhealthy target is the whole fleet — not a caller tunable.
      threshold   = 1
      dimensions  = { LoadBalancer = var.alb_arn_suffix, TargetGroup = var.api_target_group_arn_suffix }
      description = "At least one registered API target failed the /health check for three consecutive minutes. Missing data is not breaching (no registered target, e.g. a window opened without the workload stage)."
    }
  } : {}
}

# --- Alerts key (customer-managed; encrypts the alarm topic) -----------------------------
# Symmetric, rotation on, single-region, 30-day deletion window, lockout safety check on —
# the P6-CI-6 key shape. Statement 2 is the statement AWS documents for CloudWatch alarm
# actions on an encrypted topic; the topic policy below limits WHO can publish (this
# account's alarms named <name_prefix>-*), and nothing else in this composition uses the key.
resource "aws_kms_key" "alerts" {
  description                        = "SignalNest ${var.name_prefix} alerts CMK - encrypts the alarm notification topic."
  key_usage                          = "ENCRYPT_DECRYPT"
  customer_master_key_spec           = "SYMMETRIC_DEFAULT"
  enable_key_rotation                = true
  multi_region                       = false
  is_enabled                         = true
  deletion_window_in_days            = 30
  bypass_policy_lockout_safety_check = false

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "EnableIamPoliciesInThisAccount"
        Effect    = "Allow"
        Principal = { AWS = "arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:root" }
        Action    = "kms:*"
        Resource  = "*"
      },
      {
        Sid       = "AllowCloudWatchAlarmsToPublishToTheEncryptedTopic"
        Effect    = "Allow"
        Principal = { Service = "cloudwatch.amazonaws.com" }
        Action    = ["kms:Decrypt", "kms:GenerateDataKey*"]
        Resource  = "*"
      },
    ]
  })

  tags = {
    Name = "${var.name_prefix}-alerts-cmk"
  }
}

resource "aws_kms_alias" "alerts" {
  name          = "alias/${var.name_prefix}/alerts"
  target_key_id = aws_kms_key.alerts.key_id
}

# --- Alarm notification topic -------------------------------------------------------------
# The policy replaces SNS's default (any principal of the account, by AWS:SourceOwner) with
# two statements: the account root (IAM delegation, so IAM policies keep governing this
# account's principals) and CloudWatch publishing ONLY for this account's alarms named
# <name_prefix>-* (aws:SourceArn + aws:SourceAccount: the confused-deputy guard AWS documents).
resource "aws_sns_topic" "alarms" {
  name              = local.alarm_topic_name
  kms_master_key_id = aws_kms_key.alerts.arn

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "TopicOwnerAccountManagesThroughIam"
        Effect    = "Allow"
        Principal = { AWS = "arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:root" }
        Action = [
          "SNS:AddPermission",
          "SNS:DeleteTopic",
          "SNS:GetTopicAttributes",
          "SNS:ListSubscriptionsByTopic",
          "SNS:Publish",
          "SNS:RemovePermission",
          "SNS:SetTopicAttributes",
          "SNS:Subscribe",
        ]
        Resource = local.alarm_topic_arn
      },
      {
        Sid       = "CloudWatchAlarmsOfThisDeploymentPublish"
        Effect    = "Allow"
        Principal = { Service = "cloudwatch.amazonaws.com" }
        Action    = "SNS:Publish"
        Resource  = local.alarm_topic_arn
        Condition = {
          ArnLike      = { "aws:SourceArn" = local.alarm_arn_pattern }
          StringEquals = { "aws:SourceAccount" = data.aws_caller_identity.current.account_id }
        }
      },
    ]
  })

  tags = {
    Name = local.alarm_topic_name
  }
}

# The human destination. Created only when the caller supplies an address (the staging root
# requires one); pending until the recipient confirms (live human act, see the header).
resource "aws_sns_topic_subscription" "alarm_email" {
  count = var.alarm_notification_email == null ? 0 : 1

  topic_arn = aws_sns_topic.alarms.arn
  protocol  = "email"
  endpoint  = var.alarm_notification_email
}

# --- ALB alarms (P6-INF-6; follow the window) -----------------------------------------------
resource "aws_cloudwatch_metric_alarm" "alb" {
  for_each = local.alb_alarms

  alarm_name          = "${var.name_prefix}-${each.key}"
  alarm_description   = each.value.description
  namespace           = "AWS/ApplicationELB"
  metric_name         = each.value.metric
  statistic           = each.value.statistic
  period              = each.value.period
  evaluation_periods  = each.value.evaluations
  datapoints_to_alarm = each.value.evaluations
  comparison_operator = "GreaterThanOrEqualToThreshold"
  threshold           = each.value.threshold
  dimensions          = each.value.dimensions
  treat_missing_data  = "notBreaching"
  alarm_actions       = local.alarm_actions
  ok_actions          = local.alarm_actions

  lifecycle {
    precondition {
      condition     = var.alb_arn_suffix != null && var.api_target_group_arn_suffix != null
      error_message = "alb_alarms_enabled = true needs alb_arn_suffix and api_target_group_arn_suffix (the alb module's outputs while its window is open)."
    }
    precondition {
      condition     = var.alarm_thresholds.alb_5xx_count_per_period != null
      error_message = "alarm_thresholds.alb_5xx_count_per_period is required while ALB alarms exist."
    }
  }

  tags = {
    Name = "${var.name_prefix}-${each.key}"
  }
}

# --- Application-metric alarms (P6-INF-5; docs/operations/alerts.md §1 and §2) --------------
# §1 "API 5xx error ratio high": 5xx responses as a percentage of all responses over one
# 5-minute period (alerts.md: "Require sustained 5m"). FILL(errors, 0): the 5xx series is
# absent while there are none. With no requests at all the expression has no value and the
# alarm is not breaching — an idle API is not an error (availability is the ALB and ECS
# alarms' job).
resource "aws_cloudwatch_metric_alarm" "api_5xx_ratio" {
  count = var.app_metrics == null ? 0 : 1

  alarm_name          = "${var.name_prefix}-api-5xx-ratio"
  alarm_description   = "API 5xx responses exceeded the caller-supplied percentage of all API responses over 5 minutes (docs/operations/alerts.md §1). Source: CloudWatch EMF metrics from the API log stream; missing data (no requests) is not breaching."
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = 1
  threshold           = var.alarm_thresholds.api_5xx_percent
  treat_missing_data  = "notBreaching"
  alarm_actions       = local.alarm_actions
  ok_actions          = local.alarm_actions

  metric_query {
    id          = "ratio"
    expression  = "100 * FILL(errors, 0) / requests"
    label       = "API 5xx responses (% of requests)"
    return_data = true
  }

  metric_query {
    id = "errors"
    metric {
      namespace   = var.app_metrics.namespace
      metric_name = "http_requests_total"
      period      = local.period_seconds
      stat        = "Sum"
      dimensions = {
        service      = var.app_metrics.service
        environment  = var.app_metrics.environment
        outcome      = "server_error"
        status_class = "5xx"
      }
    }
  }

  metric_query {
    id = "requests"
    metric {
      namespace   = var.app_metrics.namespace
      metric_name = "http_requests_total"
      period      = local.period_seconds
      stat        = "Sum"
      dimensions = {
        service     = var.app_metrics.service
        environment = var.app_metrics.environment
      }
    }
  }

  lifecycle {
    precondition {
      condition     = var.alarm_thresholds.api_5xx_percent != null
      error_message = "alarm_thresholds.api_5xx_percent is required when app_metrics is set."
    }
  }

  tags = {
    Name = "${var.name_prefix}-api-5xx-ratio"
  }
}

# §2 "API latency p95 high": p95 over two consecutive 5-minute periods (alerts.md: 10m).
resource "aws_cloudwatch_metric_alarm" "api_p95_latency" {
  count = var.app_metrics == null ? 0 : 1

  alarm_name          = "${var.name_prefix}-api-p95-latency"
  alarm_description   = "API request latency p95 stayed above the caller-supplied milliseconds for 10 minutes (docs/operations/alerts.md §2). Source: CloudWatch EMF metrics from the API log stream; missing data (no requests) is not breaching."
  namespace           = var.app_metrics.namespace
  metric_name         = "http_request_duration_ms"
  extended_statistic  = "p95"
  period              = local.period_seconds
  evaluation_periods  = 2
  datapoints_to_alarm = 2
  comparison_operator = "GreaterThanThreshold"
  threshold           = var.alarm_thresholds.api_p95_latency_ms
  dimensions = {
    service     = var.app_metrics.service
    environment = var.app_metrics.environment
  }
  treat_missing_data = "notBreaching"
  alarm_actions      = local.alarm_actions
  ok_actions         = local.alarm_actions

  lifecycle {
    precondition {
      condition     = var.alarm_thresholds.api_p95_latency_ms != null
      error_message = "alarm_thresholds.api_p95_latency_ms is required when app_metrics is set."
    }
  }

  tags = {
    Name = "${var.name_prefix}-api-p95-latency"
  }
}
